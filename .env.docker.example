# ============================================================
# Plantilla del .env que usa Docker Compose.
#
# COPIALA A ".env" Y COMPLETALA:   cp .env.docker.example .env
#
# El .env real NUNCA se sube a GitHub (esta en .gitignore).
# Este archivo de ejemplo si se sube, porque no tiene secretos.
# ============================================================

# ---------- Donde se sirve la app ----------
# En la MV / pruebas:  :80
# En el VPS con dominio:  londoneyeenglishinstitute.site
SITE_ADDRESS=:80

# ---------- Base de datos ----------
# IMPORTANTE: usa SOLO letras y numeros en la contraseña.
# Si le pones @ : / o # rompe la URL de conexion y no conecta.
POSTGRES_USER=sge
POSTGRES_PASSWORD=cambiame_letras_y_numeros_nomas
POSTGRES_DB=sge

# ---------- Aplicacion ----------
ENV=production

# En la MV podes dejar cualquier cosa. En el VPS: largo y aleatorio.
# Generalo con:   openssl rand -base64 48
JWT_SECRET=prueba-local-cambiar-en-produccion
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

STORAGE_DRIVER=local

# URL publica del sistema (se usa en los links de los mails).
# En la MV: http://localhost   |   En el VPS: https://tudominio.site
APP_URL=http://localhost
ALLOWED_ORIGINS=http://localhost

# ---------- Mail ----------
# EN LA PRUEBA DEJA LOS DOS HOST VACIOS.
#
#   SMTP_HOST vacio -> no manda mails, solo los escribe en el log.
#   IMAP_HOST vacio -> no se conecta a la casilla real del instituto
#                      ni le toca los correos.
#
# Asi probas todo el sistema sin mandarle nada a ningun alumno real.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=London Eye <no-reply@londoneye.com>

IMAP_HOST=
IMAP_USER=
IMAP_PASS=
INBOUND_POLL_MINUTES=5
