# Servidor
PORT=8080
ENV=development

# Base de datos
DATABASE_URL=postgres://user:password@localhost:5432/bd

# JWT
JWT_SECRET=cambia-esto-por-un-secreto-seguro
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Storage de comprobantes de pago
STORAGE_DRIVER=local
STORAGE_PATH=./uploads

# CORS
ALLOWED_ORIGINS=http://localhost:5173

# URL pública del frontend (para links de emails, ej. verificación de cuenta)
APP_URL=http://localhost:5173

# SMTP — envío de correo saliente (verificación de cuenta).
# Para Gmail/Workspace: host smtp.gmail.com, puerto 587, user = casilla,
# pass = App Password (no la contraseña normal). Si SMTP_HOST queda vacío,
# el sistema NO envía y solo loguea el mail (modo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=London Eye <no-reply@londoneye.com>

# IMAP — recepción de comprobantes por mail (bandeja de entrantes).
# Para Gmail/Workspace: host imap.gmail.com, user = casilla, pass = App Password.
# Si IMAP_HOST queda vacío, el poller de comprobantes no se registra.
IMAP_HOST=
IMAP_USER=
IMAP_PASS=
INBOUND_POLL_MINUTES=5
